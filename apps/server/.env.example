# Copier en `.env` pour le développement local.
PORT=3001
LOG_LEVEL=debug
# Base SQLite et cache des images.
DATA_PATH=./data
# Bibliothèques (tableau JSON). Type : manga (droite → gauche) ou comics.
LIBRARIES=[{"name":"Mangas","path":"./library/manga","type":"manga"}]
# Scan automatique toutes les N minutes (0 = jamais).
SCAN_INTERVAL_MINUTES=30
# Adresse publique de l'appli (liens d'invitation).
PUBLIC_URL=http://localhost:5173
