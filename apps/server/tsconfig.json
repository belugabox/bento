{
    "compilerOptions": {
        "lib": ["ES2022"],
        "outDir": "./dist",
        "rootDir": "./src",
        "removeComments": true,
        "module": "commonjs",
        "target": "es2022",
        "moduleResolution": "node",
        "esModuleInterop": true,
        "skipLibCheck": true,
        "sourceMap": true,

        "strict": true,
        "allowUnreachableCode": false,
        "noImplicitReturns": true,
        "noUncheckedIndexedAccess": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,

        "types": ["node"]
    },
    "include": ["src/**/*.ts"]
}
